// HeAlthFintel Outreach veri modeli.
// Her kayıt bir çalışma alanına (workspace) bağlıdır: her kullanıcı yalnızca kendi verisini görür.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel gibi sunucusuz ortamlarda havuzlu bağlantı (Supabase "Transaction pooler", 6543),
  // şema değişiklikleri için doğrudan bağlantı (5432) kullanılır.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum AccountStatus {
  CONNECTED
  NEEDS_LOGIN
  PAUSED // LinkedIn uyarısı sonrası 24 saat
  DISCONNECTED
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ReviewMode {
  REVIEW_ALL // her mesajı onayla
  REVIEW_FIRST // ilk mesajı onayla
  AUTONOMOUS // tam otomatik
}

enum StepType {
  VISIT // davetten önce profil ziyareti
  INVITE // davet notu
  ACCEPTED_MESSAGE // kabulde detay mesajı (bekleme 0)
  CONNECTED_MESSAGE // zaten bağlantıda olunan kişiye davetsiz ilk mesaj
  FOLLOW_UP // cevap gelmezse takip
  OPEN_MESSAGE // seçenek: açık profile davetsiz mesaj
  INMAIL // seçenek: geri çekilen davet sonrası InMail
}

enum Branch {
  NEW_PERSON // 2. ve 3. derece: davetle başlar
  CONNECTED // 1. derece: doğrudan mesajla başlar
}

enum SourceKind {
  CONNECTIONS
  ACCOUNTS
  SEARCH
  ENGAGERS
  IMPORT
}

enum TemplateStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum ProspectStage {
  QUEUED
  NEEDS_REVIEW
  INVITE_SENT
  CONNECTED
  MESSAGED
  INMAIL_SENT
  REPLIED
  WITHDRAWN // davet kabul edilmedi, geri çekildi
  FINISHED // akış bitti, cevap yok
  SKIPPED
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum JobType {
  VISIT_PROFILE
  WITHDRAW_INVITE
  SEND_INVITE
  SEND_MESSAGE
  SEND_INMAIL
  SYNC_SENT_INVITES // LinkedIn'den elle gönderilen davetleri sayar
  CHECK_CONNECTIONS
  CHECK_INBOX
  DISCOVER
}

enum JobStatus {
  PENDING
  AWAITING_APPROVAL
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum ReplyLabel {
  INTERESTED
  LATER
  NOT_INTERESTED
  WRONG_PERSON
  OTHER
}

enum OpportunityStage {
  NEW // ilgileniyor
  MEETING_SET
  PROPOSAL
  WON
  LOST
}

enum AlertKind {
  RUNNER_OFFLINE // yerel çalışan bir süredir bağlanmadı
  SESSION_EXPIRED // LinkedIn oturumu düştü, yeniden giriş gerekli
  LINKEDIN_WARNING // LinkedIn uyarı/doğrulama gösterdi; hesap 24 saat duraklatıldı
  LIMIT_REACHED // haftalık davet sınırı doldu
  TEMPLATE_BLOCKED // onaylı şablon kural denetiminden geçmiyor
}

model Workspace {
  id               String   @id @default(cuid())
  name             String
  website          String?
  /// KVKK aydınlatma metninin yayınlandığı adres
  privacyNoticeUrl String?
  /// Yanıt vermeyen kişilerin verisinin silineceği süre (ay)
  retentionMonths  Int      @default(12)
  /// Gönderim yapılmayacak ek günler (YYYY-AA-GG), ör. dinî bayramlar
  quietDays        String[] @default([])
  /// Tüm kampanyalarda geçmemesi gereken ifadeler
  bannedPhrases    String[] @default([])
  /// İlk giriş kontrol listesi: tamamlanan adımların anahtarları
  onboardingDone   String[] @default([])
  createdAt        DateTime @default(now())

  members          Membership[]
  linkedinAccounts LinkedinAccount[]
  agents           Agent[]
  prospects        Prospect[]
  suppressions     Suppression[]
  auditLogs        AuditLog[]
  files            FileAsset[]
  opportunities    Opportunity[]
  notes            Note[]
  alerts           Alert[]
  invites          WorkspaceInvite[]
}

/// Ekibe e-posta ile davet: bu adresle kayıt olan kişi çalışma alanına katılır
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  invitedBy   String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model User {
  id          String       @id // Supabase auth kullanıcı id'si
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Membership {
  workspaceId String
  userId      String
  role        Role      @default(OWNER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model LinkedinAccount {
  id                String        @id @default(cuid())
  workspaceId       String
  displayName       String
  profileUrl        String?
  premium           Boolean       @default(false)
  status            AccountStatus @default(NEEDS_LOGIN)
  weeklyInvites     Int           @default(180)
  /// Davet gönderilecek günler, 0=Pazar ... 6=Cumartesi
  activeDays        Int[]         @default([0, 1, 2, 3, 4, 5, 6])
  windowStartMin    Int           @default(540) // 09:00
  windowEndMin      Int           @default(1110) // 18:30
  /// Gün gün ayar: [{enabled, windows:[{startMin,endMin}], invites?}] x 7 (0=Pazar).
  /// Doluysa activeDays/windowStart/windowEnd yerine bu kullanılır.
  schedule          Json?
  dailyMessageLimit Int           @default(80)
  /// Kalan InMail kredisi (Premium); çalışan her gün okur. null = bilinmiyor
  inmailCredits     Int?
  /// Son 7 günde panel dışından (LinkedIn'den elle) gönderilen davet sayısı; haftalık bütçeden düşülür
  externalInvites7d Int           @default(0)
  warmupEnabled     Boolean       @default(true)
  connectedAt       DateTime?
  pausedUntil       DateTime?
  /// Yerel çalışanın panele bağlanırken kullandığı anahtarın özeti (anahtarın kendisi saklanmaz)
  runnerTokenHash   String?
  runnerLastSeenAt  DateTime?
  runnerVersion     String?
  runnerPlatform    String?
  /// Planlayıcının bu hesap için en son çalıştığı an (çalışan her sorduğunda en fazla 2 dakikada bir)
  lastPlannedAt     DateTime?
  /// Son LinkedIn uyarısının metni (doğrulama, sınır vb.)
  lastWarning       String?
  createdAt         DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]
  jobs      Job[]
  alerts    Alert[]

  @@index([workspaceId])
}

model Agent {
  id                String      @id @default(cuid())
  workspaceId       String
  linkedinAccountId String
  name              String
  goal              String
  offerContext      String // değer önerisi, kanıtlar
  tone              String?
  status            AgentStatus @default(DRAFT)
  reviewMode        ReviewMode  @default(REVIEW_ALL)
  /// Bu temsilcinin hesabın haftalık bütçesindeki payı (yüzde)
  budgetSharePct    Int         @default(100)
  /// Hedefleme: unvanlar, hariç unvanlar, sektörler, konumlar, anahtar kelimeler, şirket listeleri
  targeting         Json
  /// Serbest metin uygunluk kuralı, ör. "sadece özel hastaneler, kamu hariç"
  fitRule           String?
  /// Yasak ifadeler (her mesajda denetlenir)
  bannedPhrases     String[]    @default([])
  requiredLink      String?
  /// Davetten önce profil ziyareti
  visitBeforeInvite Boolean     @default(true)
  /// Kabul edilmeyen davet kaç gün sonra geri çekilir
  withdrawAfterDays Int         @default(21)
  /// Aynı kurumdan aynı anda en fazla kaç kişiyle süreç yürütülür
  maxPerCompany     Int         @default(2)
  /// Mevcut bağlantılar da hedeflensin mi (davetsiz akış)
  includeConnections Boolean    @default(true)
  /// Sihirbaz cevapları (WizardAnswers); şablonlar bunlardan üretilir
  answers           Json?

  // ---- Seçenekler (hepsi varsayılan kapalı; kampanya ayarlarından açılır) ----
  /// Kişiye özel ilk cümle ({ilk_cumle?}); kaynaklar öncelik sırasıyla: mutual, post, school, city
  firstLineEnabled  Boolean     @default(false)
  firstLineSources  String[]    @default(["mutual", "post", "school"])
  /// Randevu linki cümlesi ({takvim_linki?})
  calendarEnabled   Boolean     @default(false)
  calendarUrl       String?
  /// Profili İngilizce olan kişilere İngilizce şablon
  englishEnabled    Boolean     @default(false)
  /// Açık profile (Open Profile) davet atmadan mesaj
  openProfileEnabled Boolean    @default(false)
  /// Geri çekilen davetten sonra InMail
  inmailEnabled     Boolean     @default(false)
  inmailMinFitScore Int         @default(80)
  /// Kampanyanın haftada harcayabileceği en fazla InMail kredisi
  inmailWeeklyMax   Int         @default(5)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedinAccount LinkedinAccount @relation(fields: [linkedinAccountId], references: [id])
  segments        Segment[]
  steps           SequenceStep[]
  prospects       AgentProspect[]
  targetAccounts  TargetAccount[]

  @@index([workspaceId])
}

/// Aynı temsilcide farklı kitleler: hastane, klinik, sigorta...
model Segment {
  id          String  @id @default(cuid())
  agentId     String
  name        String
  /// Kişinin bu segmente girme kuralı (kurum adında "klinik", "tıp merkezi" vb.)
  matchRule   String?
  agent       Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  templates   Template[]
}

model SequenceStep {
  id           String   @id @default(cuid())
  agentId      String
  branch       Branch   @default(NEW_PERSON)
  order        Int
  type         StepType
  /// Önceki adımdan sonra bekleme (saat). Kabulde mesaj için 0.
  delayHours   Int      @default(0)
  /// Mesaja eklenecek belge (davet notunda kullanılamaz)
  attachmentId String?
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  attachment   FileAsset? @relation(fields: [attachmentId], references: [id])
  templates    Template[]

  @@unique([agentId, branch, order])
}

/// Mesajlara eklenen belgeler (Supabase Storage'da tutulur; yalnızca PDF, en fazla 10 MB)
model FileAsset {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     SequenceStep[]
}

/// Hedef kurum listesi: önce kurum, sonra o kurumdaki doğru unvanlar aranır
model TargetAccount {
  id          String   @id @default(cuid())
  agentId     String
  name        String
  linkedinUrl String?
  /// Elle eklendi, şirket aramasından seçildi ya da içe aktarıldı
  origin      String   @default("manual")
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
}

/// Şablonlar sürümlüdür: yalnızca APPROVED sürüm gönderilir.
model Template {
  id         String         @id @default(cuid())
  stepId     String
  segmentId  String?
  version    Int            @default(1)
  status     TemplateStatus @default(DRAFT)
  body       String
  /// A/B testinde aynı adım ve segment için birden fazla onaylı varyant olabilir
  variant    String         @default("A")
  /// "tr" ya da "en" (İngilizce varyant seçeneği açıksa)
  lang       String         @default("tr")
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime       @default(now())

  step        SequenceStep        @relation(fields: [stepId], references: [id], onDelete: Cascade)
  segment     Segment?            @relation(fields: [segmentId], references: [id])
  messages    Message[]
  suggestions TemplateSuggestion[]

  @@index([stepId, segmentId, status, lang])
}

/// Şablon stüdyosunda yapay zekânın önerdiği değişiklikler
model TemplateSuggestion {
  id         String   @id @default(cuid())
  templateId String
  instruction String // "Daha iyi yap", "Kısalt" ya da serbest istek
  proposed   String
  rationale  String?
  accepted   Boolean?
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Prospect {
  id          String   @id @default(cuid())
  workspaceId String
  linkedinUrl String
  fullName    String
  title       String?
  company     String?
  location    String?
  headline    String?
  industry    String?
  /// Bağlantı derecesi (1 = zaten bağlantıda)
  degree      Int?
  mutualConnections Int?
  recentlyActive Boolean @default(false)
  /// Açık profil: davetsiz mesaj alabilir
  openProfile Boolean  @default(false)
  /// Profil dili ("tr" | "en"), çalışanın gördüğü unvan/özet metninden
  lang        String?
  // Kişiye özel ilk cümle için yalnızca gereken özet bilgiler (paylaşım metni saklanmaz)
  mutualName  String?
  sharedSchool String?
  /// Son paylaşımın tanınan konusu (POST_TOPICS anahtarı), metnin kendisi değil
  postTopic   String?
  /// Bu tarihe kadar hiçbir kampanyaya alınmaz (90 gün tekrar yazmama, 21 gün yeniden davet)
  cooldownUntil DateTime?
  source      SourceKind @default(SEARCH)
  /// KVKK: bu tarihten sonra cevap yoksa veri silinir
  retainUntil DateTime
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    AgentProspect[]
  messages  Message[]
  opportunities Opportunity[]
  notes     Note[]

  @@unique([workspaceId, linkedinUrl])
}

model AgentProspect {
  id          String        @id @default(cuid())
  agentId     String
  prospectId  String
  segmentId   String?
  stage       ProspectStage @default(QUEUED)
  branch      Branch        @default(NEW_PERSON)
  fitScore    Int?
  priority    Int?
  visitedAt   DateTime?
  withdrawnAt DateTime?
  fitReason   String?
  inviteSentAt DateTime?
  connectedAt DateTime?
  lastMessageAt DateTime?
  inmailSentAt DateTime?
  repliedAt   DateTime?
  /// Bu kişiye gönderilen dil
  lang        String        @default("tr")
  replyLabel  ReplyLabel?
  skipReason  String?
  createdAt   DateTime      @default(now())

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// Bir kişi aynı temsilcide bir kez yer alır
  @@unique([agentId, prospectId])
  @@index([stage])
}

model Message {
  id                String    @id @default(cuid())
  prospectId        String
  /// Hangi kampanyanın hangi adımı (gelen mesajlarda boş)
  agentId           String?
  stepId            String?
  templateId        String?
  direction         Direction
  body              String
  sentAt            DateTime  @default(now())
  providerMessageId String?

  prospect Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  @@index([prospectId, sentAt])
}

/// Gönderim kuyruğu (pg-boss işleri ayrıca tutulur; bu tablo panelde görünen durum içindir)
model Job {
  id                String    @id @default(cuid())
  linkedinAccountId String
  type              JobType
  status            JobStatus @default(PENDING)
  priority          Int       @default(10)
  runAfter          DateTime
  payload           Json
  /// İşin ait olduğu kişi kaydı (kişisiz işlerde boş: tarama, gelen kutusu kontrolü)
  agentProspectId   String?
  /// Çalışan işi aldığında kilitlenir; süre dolarsa iş yeniden verilir
  lockedUntil       DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  /// Onay modunda kullanıcıya gösterilen, düzenlenebilir metin
  draftText         String?
  attempts          Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?

  linkedinAccount LinkedinAccount @relation(fields: [linkedinAccountId], references: [id], onDelete: Cascade)

  @@index([linkedinAccountId, status, runAfter, priority])
  @@index([agentProspectId, status])
}

/// Asla ulaşılmayacak kişi ve kurumlar
model Suppression {
  id          String   @id @default(cuid())
  workspaceId String
  /// "company" ya da "person"
  kind        String
  /// Kurum adı ya da LinkedIn URL'sinin SHA-256 özeti (KVKK silme sonrası)
  value       String
  reason      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, value])
}

/// Cevap veren ve ilgilenen kişiden doğan fırsat (satış hattı)
model Opportunity {
  id          String           @id @default(cuid())
  workspaceId String
  prospectId  String
  agentId     String?
  stage       OpportunityStage @default(NEW)
  /// Bir sonraki adım ve tarihi, ör. "Demo" / 2026-10-20
  nextStep    String?
  nextStepAt  DateTime?
  lostReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect  Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, stage])
}

/// Kişi kartındaki notlar
model Note {
  id          String   @id @default(cuid())
  workspaceId String
  prospectId  String
  authorId    String
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect  Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

/// Panelin üstünde gösterilen uyarılar; çözülünce resolvedAt dolar
model Alert {
  id                String    @id @default(cuid())
  workspaceId       String
  linkedinAccountId String?
  kind              AlertKind
  message           String
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedinAccount LinkedinAccount? @relation(fields: [linkedinAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actor       String // kullanıcı id'si ya da "system"
  action      String
  details     Json?
  /// Geri alınabilir işlemler (atla, hariç tut, toplu işlem) için önceki durum
  undoData    Json?
  undoneAt    DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
