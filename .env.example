# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla GitHub'a gönderilmez.

# Supabase (ücretsiz katman) - Proje ayarları > Database > Connection string
DATABASE_URL="postgresql://postgres:SIFRE@db.PROJE.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJE.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Şablon asistanı (isteğe bağlı) - Google AI Studio'dan ücretsiz anahtar
GEMINI_API_KEY=""

# Yerel çalışan, panele bu adresten bağlanır
PANEL_URL="http://localhost:3000"
