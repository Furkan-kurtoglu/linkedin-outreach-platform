# Panel Vercel'de çalışır. Vercel'de Supabase entegrasyonu eklenince aşağıdaki veritabanı ve
# Supabase değişkenleri OTOMATİK tanımlanır; elle kopyalamak gerekmez.
# Bu dosya yalnızca paneli kendi bilgisayarınızda çalıştırmak isterseniz .env olarak kopyalanır.
# .env asla GitHub'a gönderilmez.

# --- Supabase entegrasyonunun eklediği değişkenler ---
POSTGRES_PRISMA_URL=""        # havuzlu bağlantı (pgbouncer=true)
POSTGRES_URL_NON_POOLING=""   # doğrudan bağlantı (tablo oluşturma/güncelleme)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""   # yeni projelerde NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=""       # yeni projelerde SUPABASE_SECRET_KEY; yalnızca sunucuda kullanılır

# --- Elle eklenen (gizli değil) ---
# Kayıt olabilecek e-postalar, virgülle. Boşsa herkes kayıt olabilir; doldurulması önerilir.
ALLOWED_EMAILS="ornek@alanadi.com"

# --- İsteğe bağlı ---
# Mesaj düzenleme yardımı - Google AI Studio'dan ücretsiz anahtar. Kişi bilgisi gönderilmez.
GEMINI_API_KEY=""

# E-posta bildirimleri (isteğe bağlı). Ücretsiz katman: Resend ayda 3.000 / günde 100,
# Brevo günde 300. İkisinden BİRİNİN anahtarını ekleyin; EMAIL_FROM zorunludur.
# Gönderen adresi, sağlayıcıda doğrulanmış bir alan adından olmalı (ör. bildirim@sirketiniz.com).
EMAIL_FROM=""
EMAIL_FROM_NAME="Outreach"           # görünen gönderen adı
RESEND_API_KEY=""                    # https://resend.com/api-keys
BREVO_API_KEY=""                     # https://app.brevo.com/settings/keys/api
APP_URL="https://linkedin-outreach-platform.vercel.app"  # e-postadaki bağlantılar için
