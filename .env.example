# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla GitHub'a gönderilmez.
# Panel Vercel'de çalışırken aynı değerler Vercel proje ayarlarına (Environment Variables) girilir.

# --- Supabase (ücretsiz katman) ---
# Project Settings > Database > Connection string
# Havuzlu bağlantı (Transaction pooler, port 6543): panel bunu kullanır
DATABASE_URL="postgresql://postgres.PROJE:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Doğrudan bağlantı (port 5432): yalnızca tablo oluşturma/güncelleme için
DIRECT_URL="postgresql://postgres.PROJE:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://PROJE.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Yalnızca sunucuda kullanılır (belge depolama). Asla tarayıcıya ya da çalışana verilmez.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Erişim ---
# Kayıt olabilecek e-postalar (virgülle). Boşsa herkes kayıt olabilir; panel herkese açık adreste
# çalışacağı için doldurulması önerilir. Ekip davetiyle gelenler ayrıca kabul edilir.
ALLOWED_EMAILS="furkan@ornek.com"

# --- İsteğe bağlı ---
# Şablon düzenleme yardımı - Google AI Studio'dan ücretsiz anahtar. Kişi bilgisi gönderilmez.
GEMINI_API_KEY=""
