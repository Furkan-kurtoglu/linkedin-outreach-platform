{
  "name": "healthfintel-outreach",
  "private": true,
  "version": "0.1.0",
  "description": "LinkedIn outreach platformu: panelden temsilci kur, davet gönder, kabulde anında detay mesajı.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @hfo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @hfo/db generate",
    "runner": "pnpm --filter @hfo/runner start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
